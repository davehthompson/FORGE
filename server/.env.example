PORT=3001
OPENAI_API_KEY=your_openai_api_key_here
PDL_API_KEY=your_pdl_api_key_here
DATABASE_URL=your_neon_postgres_connection_string_here
# Logo.dev publishable token (pk_*) used by enrichment + PDF services
LOGO_DEV_KEY=your_logo_dev_publishable_key_here
# Single key (backward compatible — service name defaults to "default")
FORGE_API_KEY=
# Multi-key: comma-separated key:service-name pairs (takes precedence over FORGE_API_KEY)
FORGE_API_KEYS=key1:service-a,key2:service-b
