PORT=3001
# Anthropic Claude key — used for asset generation, quick receipts, and
# domain enrichment via the hosted web_search tool.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Google Gemini key — used for receipt-image generation only.
GEMINI_API_KEY=your_gemini_api_key_here
# Postgres connection string for analytics (generation_events table).
# In production this is provided automatically by Ramplify when the app's
# managed database is enabled. Leave blank locally to disable analytics.
DATABASE_URL=
# Logo.dev publishable token (pk_*) used by enrichment + PDF services
LOGO_DEV_KEY=your_logo_dev_publishable_key_here
# Single key (backward compatible — service name defaults to "default")
FORGE_API_KEY=
# Multi-key: comma-separated key:service-name pairs (takes precedence over FORGE_API_KEY)
FORGE_API_KEYS=key1:service-a,key2:service-b
